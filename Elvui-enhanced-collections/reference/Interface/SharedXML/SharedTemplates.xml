<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    
    <Script file="SharedTemplates.lua"/>

    <Frame name="BorderIconTemplate" virtual="true">
        <Size x="32" y="32"/>

        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" parentKey="Background" setAllPoints="true"/>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentIcon" parentKey="Icon" setAllPoints="true"/>
            </Layer>
            <Layer>
                <Texture name="$parentIconBorder" parentKey="IconBorder" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <Texture name="$parentOverlay" parentKey="Overlay" setAllPoints="true"/>
            </Layer>
        </Layers>

        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "BorderIconTemplateMixin")
            </OnLoad>
        </Scripts>
    </Frame>
    
    <Button name="SpellIconTemplate" inherits="BorderIconTemplate" virtual="true">
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "SpellIconTemplateMixin")
            </OnLoad>
        </Scripts>
    </Button>

    <Button name="ItemIconTemplate" inherits="BorderIconTemplate" virtual="true">
        <Layers>
            <Layer>
                <FontString name="$parentCount" parentKey="Count" inherits="NumberFontNormal" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="-2" y="2"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "ItemIconTemplateMixin")
            </OnLoad>
        </Scripts>
    </Button>

    <Button name="CooldownItemIconTemplate" inherits="ItemIconTemplate" virtual="true">
        <Frames>
            <Cooldown name="$parentCooldown" parentKey="Cooldown" setAllPoints="true" inherits="CooldownFrameTemplate"/>
        </Frames>
        <Scripts>
            <OnLoad>
                MixinAndLoadScripts(self, "CooldownItemIconTemplateMixin")
            </OnLoad>
        </Scripts>
    </Button>

    <Frame name="DisabledOverlayTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentDisabledBlack" parentKey="DisabledBlack">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentDisabledOverlay" parentKey="DisabledOverlay">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                self.DisabledBlack:SetTexture(0, 0, 0, 0.7)
                self.DisabledOverlay:SetAtlas("talents-node-choiceflyout-square-locked")
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>